          "long": true
        },
        {
          "id": "e7b29555-0044-42da-af45-bec68f8a0dbc",
          "prompt": "Tại sao trong câu “He says eating snacks and junk food is a waste of money” động từ lại chia là “is”?",
          "options": [],
          "long": true
        },
        {
          "id": "95b19336-ac64-4817-acd2-06616de65798",
          "prompt": "Xác định các thành phần của câu sau: “He chooses to eat at the office canteen”\n\n(nếu không có gì, điền \"x\")",
          "options": [],
          "long": true
        },
        {
          "id": "5297a215-c1ca-4ee1-ae65-4a0be0b7040b",
          "prompt": "Tìm câu có cấu trúc song song trong đoạn trên",
